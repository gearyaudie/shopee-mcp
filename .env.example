# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Shopee Open Platform app credentials (from the Shopee Open Platform console) ---
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# Shopee API base host. Use the sandbox host while testing, the live host once
# the app is approved for production traffic.
# Sandbox: https://partner.test-stable.shopeemobile.com
# Live:    https://partner.shopeemobile.com
SHOPEE_API_HOST=https://partner.test-stable.shopeemobile.com

# The redirect URL registered on the Shopee app, used during the one-time shop
# authorization flow to receive the auth `code`.
SHOPEE_REDIRECT_URL=

# --- Shop-level identifiers (filled in after the OAuth authorize step) ---
# shop_id is safe to keep here; access_token/refresh_token are NOT stored here —
# they live in secrets/shopee-tokens.json, written automatically by auth.ts.
SHOPEE_SHOP_ID=

# --- Google Sheets ---
# Spreadsheet ID of the "efloor masterdata" sheet (the long id in its URL).
MASTERDATA_SHEET_ID=

# Path to the Google Cloud service account JSON key (see secrets/ below).
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/gcp-service-account.json
